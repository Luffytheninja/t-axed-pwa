rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core check: User must be signed in.
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if the current user owns the target document.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Get the current user's householdId from the /users collection.
    function getUserHouseholdId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    // --- USERS ---
    match /users/{userId} {
      // Anyone logged in can read a user profile (to see family members).
      allow read: if isSignedIn();
      
      // Users can only create or update their own profile.
      allow write: if isOwner(userId);
    }
    
    // --- HOUSEHOLDS ---
    match /households/{householdId} {
      // Anyone logged in can read or create a household.
      allow read, create: if isSignedIn();
      
      // Only people who belong to the household can update its details.
      allow update: if isSignedIn() && getUserHouseholdId() == householdId;
    }
    
    // --- GROCERY ITEMS ---
    match /grocery_items/{itemId} {
      // Users can only read or write items that belong to their current household.
      allow read, write: if isSignedIn() && (
        // For existing items (read/update/delete)
        (resource != null && resource.data.family_id == getUserHouseholdId()) ||
        // For new items (create)
        (resource == null && request.resource.data.family_id == getUserHouseholdId())
      );
    }
  }
}